.efb-modal {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 1700;
    overflow: hidden;
    outline: 0;
    background: rgba(0, 0, 0, .5);
    &:not(.show) {
        visibility: hidden;
    }
    &.show {
        display: block;
        .efb-modal-dialog {
            -webkit-transform: translate(0, 0);
            transform: translate(0, 0);
        }
    }
    &.fade {
        opacity: 0;
        transition: opacity 150ms ease-in-out;
        &.show {
            opacity: 1;
        }
    }
    .efb-modal-dialog {
        transition: transform 150ms ease-in-out;
        -webkit-transform: translate(0, -100%);
        transform: translate(0, -100%);
        position: relative;
        width: auto;
        margin: 30px auto;
    }
    .efb-modal-loader {
        position: absolute;
        top: calc(50% - 2rem);
        left: calc(50% - 2rem);
        text-align: center;
        width: 4rem;
        height: 4rem;
        background: transparent;
        border-radius: 50%;
        border: 0.5rem solid white;
        border-top-color: transparent;
        animation: efb-loader-spin 2s infinite linear;
    }
    @keyframes efb-loader-spin {
        from {
            transform: rotate(0deg);
        }
        to {
            transform: rotate(360deg);
        }
    }
    .efb-modal-header {
        padding: 15px 20px;
        padding-right: 20px;
        border-bottom: none;
        display: -ms-flexbox;
        color: white;
        display: flex;
        -ms-flex-align: start;
        align-items: flex-start;
        -ms-flex-pack: justify;
        justify-content: space-between;
        border-bottom: 1px solid #e4eaec;
        border-top-left-radius: .286rem;
        border-top-right-radius: .286rem;
        .close {
            -ms-flex-order: 2;
            order: 2;
            margin-top: 1px;
            padding: 0;
            cursor: pointer;
            background-color: transparent;
            border: 0;
            -webkit-appearance: none;
            float: right;
            font-size: 21px;
            font-weight: 700;
            line-height: 1;
            color: white;
            text-shadow: none;
            opacity: 1;
        }
        .efb-modal-title {
            -ms-flex-order: 1;
            word-break: break-all;
            font-weight: 600;
            order: 1;
            margin-top: 0;
            margin-bottom: 0;
            line-height: 1.57142857;
        }
    }
    .efb-modal-body {
        padding: 1rem;
        background: white;
        table td {
            vertical-align: top;
        }
        .efb-pro-demo {
            width: 100%;
            height: 310px;
        }
    }
    .efb-modal-footer {
        display: -ms-flexbox;
        display: flex;
        -ms-flex-align: center;
        align-items: center;
        -ms-flex-pack: end;
        justify-content: flex-end;
        background: white;
        padding: 10px;
        border-top: 1px solid #e4eaec;
        &>:not(:last-child) {
            margin-right: .25rem;
        }
        &>:not(:first-child) {
            margin-left: .25rem;
        }
    }
    .btn-success,
    .bg-success {
        color: #fff;
        background-color: #46be8a;
        border-color: #46be8a;
    }
}

@media (min-width: 768px) {
    .efb-modal-dialog {
        width: auto;
        margin: 30px auto;
    }
}

@media (min-width: 480px) {
    .efb-modal-dialog {
        max-width: 600px;
        margin: 30px auto;
    }
    .efb-modal-content {
        box-shadow: 0 2px 12px rgba(0, 0, 0, .2);
    }
}


/* Modal css ends */


/* Toater Code Starts Here */

.efb-toaster.toaster-container {
    position: fixed;
    width: 100%;
    top: 1vw;
    left: 0;
    opacity: 0;
    text-align: center;
    transition: top 0.3s linear, opacity 0.3s linear;
    display: none;
    &.fade {
        top: 6vw;
        opacity: 1 !important;
    }
    &.show {
        display: block;
    }
    .toaster-message {
        padding: 1rem 2rem;
        color: white;
        border-radius: 2px;
        background-color: #424242;
    }
}


/* Toaster Code Ends Here */


/* Switch Code Starts Here */

.efb-switch {
    height: 1rem;
    width: 2rem;
    margin: 0 auto 5px auto;
    cursor: pointer;
    display: block;
    input {
        display: none;
        &:checked+.switch-container .switch-lever {
            left: 1rem;
        }
        &:not(:checked)+.switch-container {
            .switch-background {
                background-color: #000000 !important;
            }
            .switch-lever {
                left: 0;
                background-color: white !important;
            }
        }
    }
    .switch-container {
        height: 100%;
        width: 100%;
        position: relative;
        .switch-background {
            height: 0.8rem;
            width: inherit;
            border-radius: 1rem;
            opacity: 0.5;
            margin: 0.35rem 0;
            transition: background-color 0.2s linear;
        }
        .switch-lever {
            position: absolute;
            height: 1rem;
            width: 1rem;
            border-radius: 50%;
            top: -0.1rem;
            box-shadow: grey 0px 0px 1px 0px;
            transition: left 0.2s linear, background-color 0.2s linear;
        }
    }
}


/* Switch Code Ends Here */

