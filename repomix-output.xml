        display: none;
    }
    .efb-settings-tab:not(.active) {
        display: none;
    }
}

.efb-settings-tab-list {
    height: 100%;
    margin: 0;
    background-color: rgba(255, 255, 255, 0.8);
    .efb-settings-tab-list-item {
        list-style: none;
        cursor: pointer;
        a {
            text-decoration: none;
        }
        &.active h4 {
            color: white;
        }
        &:not(.active) {
            background-color: transparent !important;
        }
    }
}

