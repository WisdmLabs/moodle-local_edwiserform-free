<file path="formbuilderjs/src/sass/components/_stage.scss">
@import './group-actions';
@import './row';
@import './row-edit';
@import './column';
@import './field';
@import './field-edit';
@import './panels';
@import './steps';

.stage-wrap {
  position: relative;
  width: 100%;
  box-sizing: border-box;
  transition: width 250ms;
  margin-right: 5px;
  height: 100%;

  @include breakpoint('phone-lrg') {
    width: calc(100% - 50px);
  }


  .stage {
    @extend %no-list-style;
    transition-property: background-color, border-color;
    transition-duration: 500ms, 333ms;
    background-color: $stage-background;
    padding-left: $action-btn-width - 1;
    overflow: visible;
    height: 100%;
    padding-bottom: 1rem;

    &.empty-stages {
      border: 3px dashed $gray-lighter;
      background-color: $shadow;
    }

    &.removing-all-fields {
      .stage-rows {
        transition: margin-top 250ms ease-in;
      }
    }
  }

  &.editing-stage {
    .formeo-settings {
      display: block;
    }

    .stage {
      display: none;
    }
  }

  .f-field-group {
    margin-bottom: 0;
  }
}

// element label
[class*='empty-'] {
  &[class*='editing-'] {
    &::after {
      opacity: 0;
    }
  }

  &::after {
    opacity: 1;
    font-size: 24px;
    position: absolute;
    top: 50%;
    left: 50%;
    color: $gray-light;
    transition: opacity 200ms ease-in-out;
    will-change: opacity;
    text-align: center;
    transform: translate(-50%, -50%);
    content: attr(data-hover-tag);
  }
}

.formeo-settings {
  display: none;
}
