<file path="formbuilderjs/src/sass/base/_variables.scss">
$brand-primary: #325d88 !default;
$brand-primary-dark: darken($brand-primary, 10%) !default;
$brand-success: #93c54b !default;
$brand-success-dark: darken($brand-success, 10%) !default;
$brand-warning: #f47c3c !default;
$brand-warning-dark: darken($brand-warning, 10%) !default;
$brand-error: #d9534f !default;
$brand-error-dark: darken($brand-error, 10%) !default;

$remove-bg: rgba(217, 83, 79, 0.5) !default;

$row-outline-color: #325d88;
$column-outline-color: #29abe0;
$field-outline-color: #93c54b;

$input-focus: #66afe9;

$prop-btn-width: 2rem;
$action-btn-width: 2rem;

// Colors
//
// Grayscale and brand colors for use across Bootstrap.
$black: #000;
$white: #fff;
$off-white: #fefefe;

// $gray-dark: #373a3c !default;
$gray-dark: lighten($black, 20%) !default;
$gray: lighten($black, 40%) !default;
$gray-light: lighten($black, 60%) !default;
$gray-lighter: lighten($black, 80%) !default;
$gray-lightest: lighten($black, 90%) !default;

// Stage
$stage-background: rgba(255, 255, 255, 0);
$shadow: rgba(255, 255, 255, 0.25);

$border-radius: 6px;
$input-border-radius: 3px;
$input-btn-border-width: 1px;
$input-padding: 0.3em 0.6em;
$input-border: $input-btn-border-width solid $gray-lighter;
$checkbox-character: '✔' !default;

$style-width: 250px;
</file>

<file path="formbuilderjs/src/sass/components/_column.scss">
.stage-columns {
  transition: background-color 125ms ease-in-out, box-shadow 125ms, width 250ms;
  position: relative;
  background-color: $white;
  max-width: none;
  flex-direction: column;
  flex: auto;
  will-change: width;

  &[class*='col-'] {
    padding: 0;
  }

  @extend %no-list-style;

  &:first-of-type {
    border-top-right-radius: 5px;
  }

  &:last-of-type {
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;

    .resize-x-handle {
      display: none !important;
    }
  }

  .resize-x-handle {
    display: none;
    position: absolute;
    right: -8px;
    top: 0;
    bottom: 0;
    width: 16px;
    z-index: 2;
    cursor: ew-resize;

    &::before {
      width: 0;
      right: 6px;
      border: 1px dashed $column-outline-color;
      border-width: 0 2px;
      display: block;
      top: 0;
      position: absolute;
      height: 100%;
      content: '';
    }

    svg {
      fill: $column-outline-color;
      position: absolute;
      right: 1px;
      width: 14px;

      &.svg-icon-triangle-down {
        top: -14px;
      }

      &.svg-icon-triangle-up {
        bottom: -14px;
      }
    }
  }

  &::before {
    @extend %element-tag;

    transition-property: height;
    transition-duration: 150ms;
    padding: 0 10px;
    left: 50%;
    top: 1px;
    transform: translate(-50%, -100%);
    width: auto;
    height: 0;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
  }

  &.hovering-column {
    &:first-child {
      border-top-left-radius: 0;
    }

    .stage-fields {
      opacity: 0.5;
    }

    &::after {
      opacity: 0;
    }

    .column-actions {
      width: 3 * $action-btn-width;
    }
  }

  &.editing-column,
  &.hovering-column {
    box-shadow: 0 0 0 1px $column-outline-color inset;

    &::before {
      height: 23px;
      border-right: 1px solid $column-outline-color;
      border-left: 1px solid $column-outline-color;
      border-top: 1px solid $column-outline-color;
    }
  }

  &.column-moving {
    box-shadow: 0 0 0 1px $column-outline-color inset, 0 0 30px 0 $gray-light;
  }

  &.editing-column {
    overflow: hidden;

    .column-edit {
      display: block;
    }
  }

  &.empty-columns {
    &::after {
      // margin-top: 11px;

    }
  }
}

.editing-row {
  .stage-columns.hide-column {
    display: none !important;
  }
  .stage-columns,
  .empty-columns {
    display: table-cell;
    border-radius: 5px;
    height: 60px;
    background-color: $gray-lightest;

    &.empty-columns {
      min-height: 0;
    }

    .stage-fields {
      display: none;
    }

    .resize-x-handle {
      display: block;
    }

    &::after {
      color: $gray-dark !important;
      line-height: 1em;
      opacity: 1;
      font-size: 1.1em;
      content: attr(data-col-width) !important;
      display: block;
      width: 100%;
      text-align: center;
      position: absolute;
      left: 50%;
      margin-top: 0;
      top: 50%;
      transform: translate(-50%, -50%);
    }

    // &::before {
    //   top: 0;
    //   transform: translate(-50%, 0);
    //   height: 18px;
    //   line-height: 1.5;
    //   background: transparent;
    // }

  }
}

.editing-field-preview {
  .column-actions {
    display: none;
  }
}
</file>

<file path="formbuilderjs/src/sass/components/_controls.scss">
.formeo-controls {
  position: fixed;
  top: 0;
  bottom: 0px;
  width: 250px;
  height: auto;
  overflow-y: scroll;
  overflow-x: hidden;
  transition: width .5s,right .5s;
  background-color: #fff;
  padding: 100px 10px 0px;
  z-index: 10;
  &.pull-left {
    .form-actions {
      float: left;
    }
  }

  .control-group {
    border-bottom: 1px solid #ccc;
    &.collapsed-controls {
      .control-list {
        overflow-y: hidden;
        height: 0;
        padding: 0px;
      }
    }
    .control-label {
      cursor: pointer;
      h4 {
        margin-top: 11px;
        margin-bottom: 11px;
        i {
          float: right;
          transition: transform 0.5s ease;
        }
        label {
          cursor: pointer;
        }
      }
    }
    &:not(.collapsed-controls) {
      .control-label{
        h4 {
          i {
            transform: rotate(90deg);
          }
        }
      }
      .control-list {
        border-top: 1px solid #ccc;
      }
    }
    .control-list {
      transition: height 0.5s ease;
      overflow: hidden;
      .field-control {
        border: none;
        button {
          width: 100%;
          text-align: left;
          font-weight: 400;
          opacity: 0.7;
        }
      }
    }
  }

  .controls-toggle {
    position: fixed;
    top: calc(50% + 25px);
    width: 30px;
    height: 50px;
    border-radius: 50px 0 0 50px;
    text-align: center;
    transition: right 0.5s;
    &:hover {
      opacity: 1;
    }
    i {
      line-height: 50px;
      font-size: 1.5em;
      transform: rotateY(0deg);
      transition: transform 0.5s;
      color: white;
    }
  }

  .filtered-term {
    background-color: $white;
    text-align: center;
    border-radius: $input-border-radius $input-border-radius 0 0;
    border: 1px solid $gray-lighter;
    border-bottom: 0 none;
    width: calc(100% - 2px);
  }

  nav {
    position: relative;
    padding: 0 $action-btn-width;
    overflow: hidden;

    h5 {
      font-size: 13px;
      line-height: 22px;
    }

    button {
      position: absolute;
      width: $action-btn-width;
      color: $black;
      height: calc(100% + 1px);
      padding: 0;
      line-height: 0;
      margin: 0;
      border-color: $gray-lighter;

      &.next-group {
        right: 0;
        top: 0;
        border-top-left-radius: 0;
        border-top-right-radius: $border-radius;
        border-bottom-left-radius: 0;
        border-bottom-right-radius: 0;
      }

      &.prev-group {
        border-top-left-radius: $border-radius;
        border-bottom-left-radius: 0;
      }
    }
  }

  .panels-wrap {
    font-size: .85em;
    line-height: 1.8em;
  }

  .panel-labels {
    border-top: 1px solid $gray-lighter;

    // border-radius: $border-radius;

  }

  .panel-count-1 {
    border-bottom-left-radius: 0;

    .panel-nav {
      display: none;
    }
  }

  ul {
    @extend %no-list-style;
  }

  // .control-group {
  //   vertical-align: top;
  //   display: inline-block;
  //   width: 100%;
  //   border-top: 1px solid $gray-lighter;

  //   > li {
  //     &:first-child {
  //       border-top-right-radius: 0;
  //     }

  //     &:last-child {
  //       border-radius: 0 0 $border-radius $border-radius;
  //     }
  //   }
  // }

  &.filtered {
    .panel-nav {
      display: none;
    }
  }

  @include breakpoint('phone-lrg') {
    width: 45px;

    // .control-group {
    //   text-indent: -9999px;
    // }

    .form-actions {
      display: inline-block;
      width: 100%;
      position: relative;
      vertical-align: middle;
      float: none;
      margin-top: 10px;

      > button + button {
        margin-top: -$input-btn-border-width;
        margin-left: 0;
      }

      > button {
        max-width: 100%;
        padding: 10px;
        border-radius: 0;
        line-height: 0;
        width: 100%;

        border: 1px solid transparent;
        border-radius: .215rem;

        &:not(:first-child):not(:last-child) {
          border-radius: 0;
        }

        &:first-child:not(:last-child) {
          border-top-right-radius: $input-border-radius;
          border-top-left-radius: $input-border-radius;
          border-bottom-right-radius: 0;
          border-bottom-left-radius: 0;
        }

        &:last-child:not(:first-child) {
          border-bottom-left-radius: $input-border-radius;
          border-bottom-right-radius: $input-border-radius;
          border-top-right-radius: 0;
          border-top-left-radius: 0;
        }
      }

      .svg-icon,
      .glyphicon {
        display: inline-block;
        margin-right: 10px;
      }
    }
  }


  .field-control {
    @extend %field-control;

    .svg-icon {
      pointer-events: none;
    }
    &.disable-control {
      display: none !important;
    }
  }
}
</file>

