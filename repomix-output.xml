            text-align: center;
            vertical-align: middle;
            white-space: nowrap;
            border: 1px solid #838b8e;
            border-radius: .215rem;
            color: #ffff;
            font-size: 1rem;
            font-weight: 300;
            line-height: 1.571429;
            padding: .429rem 1rem;
            border-color: #838b8e;
            background-color: #838b8e;
            position: relative;
            margin: 1px 1px 1px 25px;
            &:before {
                content: '';
                position: absolute;
                left: -1.5rem;
                top: -1px;
                border-width: 1.27rem;
                border-style: solid;
                border-color: #838b8e;
                border-left-color: transparent;
            }
            &:after {
                content: '';
                position: absolute;
                right: -2.5rem;
                top: -1px;
                border-width: 1.27rem;
                border-style: solid;
                border-color: transparent;
                border-left-color: #838b8e;
            }
            &.complete {
                color: #fff;
                border-color: #46be8a;
                background-color: #46be8a;
                &:before {
                    border-color: #46be8a;
                }
                &:after {
                    border-left-color: #46be8a;
                }
            }
            &.active {
                color: #fff;
                border-color: #62a8ea;
                background-color: #62a8ea;
                &:before {
                    border-color: #62a8ea;
                    border-left-color: transparent;
                }
                &:after {
                    border-color: transparent;
                    border-left-color: #62a8ea;
                }
