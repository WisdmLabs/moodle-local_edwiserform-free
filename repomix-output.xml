  }

  &.field-moving {
    box-shadow: 0 0 0 1px $field-outline-color inset, 0 0 30px 0 $gray-light;
    background-color: $white;
  }

  &.editing-field {
    background-color: $gray-lightest;
    z-index: 1;
  }

  &.field-type-hidden {
    border: 1px dashed $gray-lighter;
  }
}

.editing-field-preview {
